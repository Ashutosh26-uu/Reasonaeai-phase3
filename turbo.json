{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".mastra/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "REASONATE_BUILD_SANDBOX_IMAGE",
        "REASONATE_TEST_BUILD_SANDBOX_IMAGE"
      ],
      "outputs": []
    },
    "//#check": {},
    "//#fix": {
      "cache": false
    }
  }
}
