{
  "name": "reasonateai-phase3",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous multimodal AI CTO",
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "dev": "node --env-file-if-exists=apps/api/.env node_modules/turbo/bin/turbo run dev --filter=@reasonateai/api --filter=@reasonateai/worker --filter=@reasonateai/web --env-mode=loose",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "lefthook": "^2.1.14",
    "turbo": "^2.10.13",
    "typescript": "catalog:",
    "ultracite": "^7.12.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  }
}
