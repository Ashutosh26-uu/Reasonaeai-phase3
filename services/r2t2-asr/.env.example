# Host port for R2T2 ASR HTTP service (bound to loopback 127.0.0.1 only)
ASR_PORT=8081

# Host path holding exactly one model *.gguf and one mmproj*.gguf projector
# from netease-youdao/Confucius4-R2T2-GGUF (Q8_0 recommended)
R2T2_GGUF_DIR=${HOME}/.cache/models/Confucius4-R2T2-GGUF

# GPU device index visible to the container (0 for first GPU)
CUDA_VISIBLE_DEVICES=0

# Host CPU threads llama.cpp may use for non-GPU operations
ASR_N_THREADS=8

# Wall-clock timeout budget per transcription request in seconds (0 to disable)
ASR_REQUEST_TIMEOUT_SEC=120

# Structured log level (DEBUG, INFO, WARNING, ERROR)
ASR_LOG_LEVEL=INFO

# Optional default language hint (e.g. English, Chinese). Unset for auto-detect
ASR_LANGUAGE_DEFAULT=
