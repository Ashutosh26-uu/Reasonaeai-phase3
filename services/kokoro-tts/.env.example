# Kokoro TTS stack — environment template.
#
# Copy beside compose.yaml and edit:
#     cp .env.example .env
# Docker Compose reads a `.env` in the same directory automatically; no env_file entry
# is needed. Do not commit `.env` (the repository ignores `.env` and `.env.*`).
#
# This file contains no secrets. The service authenticates nothing: it is published on
# 127.0.0.1 only and is meant to be called by the product API on the same host.

# Host port the API is published on. Always bound to 127.0.0.1, never to a public
# interface. Change this only to dodge a port collision on the host.
KOKORO_TTS_PORT=8880

# Voice a request falls back to when it omits `voice` (a Kokoro voicepack id such as
# `af_heart`). Keep in step with the product's REASONATE_TTS_VOICE so the two agree.
KOKORO_TTS_VOICE=af_heart

# Declared default speaking rate. 0.5-2.0 is the useful band.
# Kokoro applies `speed` per request and has no server-side default-speed setting, so
# callers send this value in the request body; compose forwards it to the container as
# DEFAULT_SPEED purely so the agreed value is visible in `docker compose config`.
KOKORO_TTS_SPEED=1.0

# Name of the Docker named volume that holds the model and tuner cache. Compose creates
# it on first `up`. Because the volume shadows the image's baked weights, a fresh volume
# triggers a one-time verified download; `docker compose down -v` deletes it and forces
# that download again.
KOKORO_TTS_CACHE_VOLUME=reasonate-kokoro-model-cache
