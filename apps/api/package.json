{
  "name": "@reasonateai/api",
  "version": "0.1.0",
  "private": true,
  "description": "ReasonateAI web API and autonomous CTO runtime host.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "mastra build && node scripts/build-server.mjs",
    "check": "ultracite check .",
    "cto:chat": "tsx src/cli/cto-chat.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "smoke:checkpoint": "tsx src/cli/smoke-checkpoint.ts",
    "smoke:guidance": "tsx src/cli/smoke-guidance.ts",
    "start": "node --env-file-if-exists=.env .mastra/output/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@mastra/core": "^1.67.0",
    "@mastra/docker": "^0.8.0",
    "@mastra/duckdb": "^1.9.0",
    "@mastra/hono": "1.7.6",
    "@mastra/libsql": "^1.23.0",
    "@mastra/observability": "^1.17.8",
    "@reasonateai/artifact-store": "workspace:*",
    "@reasonateai/auth": "workspace:*",
    "@reasonateai/contracts": "workspace:*",
    "@reasonateai/cto-runtime": "workspace:*",
    "@reasonateai/project-state": "workspace:*",
    "@reasonateai/sandbox": "workspace:*",
    "hono": "4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "mastra": "^1.30.0",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "turbo": {
    "tasks": {
      "build": {
        "cache": false
      }
    }
  }
}
