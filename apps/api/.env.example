DATABASE_URL=postgres://<user>:<password>@127.0.0.1:55432/<database>
REDIS_URL=redis://127.0.0.1:56379
SESSION_SECRET=
REASONATE_ARTIFACT_URL_SECRET=
REASONATE_PUBLIC_ORIGIN=http://localhost:3219
REASONATE_ALLOWED_ORIGINS=http://localhost:3219
DEEPSEEK_API_KEY=

# Speech adapters. Each names the exact OpenAI-compatible endpoint URL the
# adapter posts to (services/r2t2-asr and services/kokoro-tts bring up local
# ones). Left empty, voice routes answer 503 voice_unconfigured instead of
# inventing text or audio.
REASONATE_ASR_URL=
REASONATE_ASR_API_KEY=
REASONATE_ASR_MODEL=
REASONATE_TTS_URL=
REASONATE_TTS_API_KEY=
REASONATE_TTS_MODEL=
REASONATE_TTS_VOICE=
