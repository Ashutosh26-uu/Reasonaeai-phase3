# pnpm dev seeds missing local settings and random credentials in the ignored .env.
# Leave DATABASE_URL blank for a fresh checkout, or supply your existing database.
NODE_ENV=development
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379
SESSION_SECRET=
REASONATE_ARTIFACT_URL_SECRET=
REASONATE_PUBLIC_ORIGIN=http://localhost:3219
REASONATE_ALLOWED_ORIGINS=http://localhost:3219
REASONATE_PREVIEW_FRAME_ORIGIN=http://localhost:3219
# Optional: unique lowercase namespace for an independent local deployment
REASONATE_PREVIEW_NAMESPACE=
DEEPSEEK_API_KEY=
# pnpm dev prepares this repository-owned image if it is missing.
REASONATE_BUILD_SANDBOX_IMAGE=reasonate-build-sandbox:node22

# Launch identity providers (configure through company secrets, never commit keys)
RESEND_API_KEY=
REASONATE_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only: loopback Mailpit HTTP API; ignored in production
REASONATE_MAILPIT_URL=http://127.0.0.1:58027

# Optional speech: pnpm dev starts these stacks only when endpoints are configured.
# Recognition also requires the documented local GGUF files and supported GPU.
REASONATE_ASR_URL=
REASONATE_TTS_URL=
