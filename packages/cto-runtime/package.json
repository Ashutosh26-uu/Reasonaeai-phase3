{
  "name": "@reasonateai/cto-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.js"
    },
    "./agents/catalog": {
      "types": "./src/agents/catalog.ts",
      "import": "./dist/agents/catalog.js"
    },
    "./agents/definitions": {
      "types": "./src/agents/definitions/index.ts",
      "import": "./dist/agents/definitions/index.js"
    },
    "./agents/delegation": {
      "types": "./src/agents/delegation.ts",
      "import": "./dist/agents/delegation.js"
    },
    "./agents/frontmatter": {
      "types": "./src/agents/frontmatter.ts",
      "import": "./dist/agents/frontmatter.js"
    },
    "./agents/loader": {
      "types": "./src/agents/loader.ts",
      "import": "./dist/agents/loader.js"
    },
    "./agents/materialize": {
      "types": "./src/agents/materialize.ts",
      "import": "./dist/agents/materialize.js"
    },
    "./agents/tool-filter": {
      "types": "./src/agents/tool-filter.ts",
      "import": "./dist/agents/tool-filter.js"
    },
    "./agents/types": {
      "types": "./src/agents/types.ts",
      "import": "./dist/agents/types.js"
    },
    "./prompts": {
      "types": "./src/prompts.ts",
      "import": "./dist/prompts.js"
    },
    "./run-scope": {
      "types": "./src/run-scope.ts",
      "import": "./dist/run-scope.js"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./dist/runtime.js"
    },
    "./resources/handlers": "./src/resources/handlers/index.ts",
    "./resources/artifacts": "./src/resources/artifacts.ts",
    "./resources/types": "./src/resources/types.ts",
    "./resources/json-path": "./src/resources/json-path.ts",
    "./tools/selectors": "./src/tools/selectors.ts",
    "./context/compose": "./src/context/compose.ts",
    "./context/environment": "./src/context/environment.ts",
    "./context/instructions": "./src/context/instructions.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "ultracite check .",
    "pretest": "pnpm --filter @reasonateai/contracts build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@mastra/memory": "^1.30.0",
    "@reasonateai/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
