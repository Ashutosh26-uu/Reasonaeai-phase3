{
  "name": "@reasonateai/sensory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./asr": {
      "types": "./src/asr/index.ts",
      "import": "./dist/asr/index.js"
    },
    "./asr/whisper": {
      "types": "./src/asr/whisper.ts",
      "import": "./dist/asr/whisper.js"
    },
    "./tts": {
      "types": "./src/tts/index.ts",
      "import": "./dist/tts/index.js"
    },
    "./tts/piper": {
      "types": "./src/tts/piper.ts",
      "import": "./dist/tts/piper.js"
    },
    "./vision": {
      "types": "./src/vision/vision.adapter.ts",
      "import": "./dist/vision/vision.adapter.js"
    },
    "./vision/provider": {
      "types": "./src/vision/vision.openai-compatible.provider.ts",
      "import": "./dist/vision/vision.openai-compatible.provider.js"
    },
    "./gateway": {
      "types": "./src/gateway/index.ts",
      "import": "./dist/gateway/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/asr/whisper_worker.py dist/asr/whisper_worker.py && cp src/tts/piper_worker.py dist/tts/piper_worker.py",
    "check": "ultracite check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@reasonateai/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
